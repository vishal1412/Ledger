{
  "version": 2,
  "buildCommand": "npm install",
  "functions": {
    "server.js": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/*.js": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/health$",
      "dest": "/api/health.js"
    },
    {
      "src": "/api/storage$",
      "dest": "/api/storage.js"
    },
    {
      "src": "/api/upload$",
      "dest": "/api/upload.js"
    },
    {
      "src": "/api/parties$",
      "dest": "/api/parties.js"
    },
    {
      "src": "/api/purchases$",
      "dest": "/api/purchases.js"
    },
    {
      "src": "/api/sales$",
      "dest": "/api/sales.js"
    },
    {
      "src": "/api/payments$",
      "dest": "/api/payments.js"
    },
    {
      "src": "/api/stock$",
      "dest": "/api/stock.js"
    },
    {
      "src": "/api/alerts$",
      "dest": "/api/alerts.js"
    },
    {
      "src": "/api/settings$",
      "dest": "/api/settings.js"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
